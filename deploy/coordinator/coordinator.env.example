# gala-coordinator: Konfiguration. Kopie nach /etc/gala/coordinator.env
# (Rechte 0640 root:root). install.sh legt die Datei an und füllt leere
# Geheimnisse (POSTGRES_PASSWORD, GALA_INTERNAL_TOKEN) mit Zufallswerten.
#
# Format: nur KEY=VALUE, ohne Anführungszeichen. Werte ohne Leerzeichen und
# Sonderzeichen (die Datei wird von docker compose UND von Shell-Skripten gelesen).

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=gala
POSTGRES_USER=gala
# leer lassen: install.sh erzeugt ein Passwort (openssl rand -hex 24)
POSTGRES_PASSWORD=

# --- Coordinator ------------------------------------------------------------
# Schutz der schreibenden /internal-Routen (update.sh nutzt ihn zum Beenden des Wartungsmodus)
GALA_INTERNAL_TOKEN=
# Adresse, unter der die Desktop-Apps den Server erreichen (für Download-/Update-URLs)
GALA_PUBLIC_URL=https://gala-coordinator
# Name im TLS-Zertifikat von Caddy (die IP kommt aus hosts.env)
GALA_HOSTNAME=gala-coordinator
GALA_LLM_URL=http://gala-llm:8080
RUST_LOG=info
# Cargo-Features des Coordinator-Images. "embed" = Dokumenten-Chatbot (BGE-M3 über
# ONNX Runtime; braucht eine CPU mit AVX/AVX2, in Proxmox CPU-Typ "host" oder
# x86-64-v3). Leer = ohne Chatbot, POST /api/v1/chat antwortet mit 501.
# Nicht gesetzt = "embed". Nach einer Änderung: dc.sh coordinator up -d --build
#GALA_COORDINATOR_FEATURES=

# --- Pfade auf dem Host (von update.sh und backup.sh gelesen) -----------------
# Update-Anfrage/-Status; wird 1:1 in den Container gemountet
GALA_STATE_DIR=/var/lib/gala/state
# Wo update.sh den Coordinator für den Wartungsmodus erreicht
GALA_INTERNAL_URL=http://127.0.0.1:8081
# Update-Ziel, wenn die Anfrage keinen ref enthält
GALA_UPDATE_DEFAULT_REF=main

# --- Backup (backup.sh, täglich per gala-backup.timer) -------------------------
GALA_BACKUP_DIR=/srv/gala/backup
GALA_BACKUP_KEEP_DAYS=14
# Optional: zusätzlich /srv/gala/data per rsync dorthin spiegeln (z. B. ein
# eingebundenes NAS-Backup-Ziel oder user@host:/pfad). Leer = aus.
GALA_BACKUP_RSYNC_TARGET=
