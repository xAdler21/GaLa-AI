# gala-llm: Konfiguration. Kopie nach /etc/gala/llm.env (Rechte 0644 genügt, keine Geheimnisse).

# GGUF-Datei in /srv/gala/models (Platzhalter: ein 14B-Modell, Q4_K_M, ca. 9 GB).
# Auf den tatsächlichen Dateinamen anpassen.
LLM_MODEL=Qwen3-14B-Q4_K_M.gguf

# Gesamt-Kontext in Tokens; je --parallel-Slot (2) gilt die Hälfte.
LLM_CTX=16384

# Anteil der Layer pro GPU, Reihenfolge = PCI-Bus (GPU 0 = RTX 3070, GPU 1 = GTX 1070).
# 1,1 = gleichmäßig. Beide Karten haben 8 GB; wenn die 3070 mehr tragen soll: 3,2.
LLM_TENSOR_SPLIT=1,1

# Image-Tag von ghcr.io/ggml-org/llama.cpp, am besten auf einen Build pinnen
# (Tags: https://github.com/ggml-org/llama.cpp/pkgs/container/llama.cpp).
# "server-cuda" ist mit CUDA 12 gebaut (Stand 11.11.2026: 12.8.1). Nicht
# "server-cuda13" nehmen: CUDA 13 unterstützt die GTX 1070 (Pascal) nicht mehr.
LLAMA_IMAGE_TAG=server-cuda
