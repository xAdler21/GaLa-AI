# gala-llm: Konfiguration. Kopie nach /etc/gala/llm.env (Rechte 0644 genügt, keine Geheimnisse).

# GGUF-Datei in /srv/gala/models. Im Betrieb seit 26.11.2026: gpt-oss-20b (MoE, 21B, 3,6B aktiv),
# MXFP4, 12,1 GB, https://huggingface.co/ggml-org/gpt-oss-20b-GGUF. Gemessen auf 3070 + 1070:
# Prompt ~1500 Token/s, Antwort ~65 Token/s (Qwen3-14B Q4_K_M davor: ~470 und ~22).
# Rückweg: LLM_MODEL=Qwen3-14B-Q4_K_M.gguf, LLM_REASONING=off, LLM_REASONING_EFFORT=default.
LLM_MODEL=gpt-oss-20b-MXFP4.gguf

# Denkphase des Modells vor der Antwort: off, on oder auto (aus dem Chat-Template).
# gpt-oss denkt immer; LLM_REASONING_EFFORT (minimal, low, medium, high) bestimmt, wie lange.
# "default" lässt die Vorgabe des Templates.
LLM_REASONING=auto
LLM_REASONING_EFFORT=low

# Gesamt-Kontext in Tokens; je --parallel-Slot (2) gilt die Hälfte. 32768 belegt mit
# gpt-oss-20b rund 7,0 GB auf der 3070 (mit Reranker) und 6,0 GB auf der 1070 (26.11.2026).
LLM_CTX=32768

# Anteil der Layer pro GPU, Reihenfolge = PCI-Bus (GPU 0 = RTX 3070, GPU 1 = GTX 1070).
# 1,1 = gleichmäßig. Beide Karten haben 8 GB; der Reranker liegt zusätzlich auf GPU 0.
LLM_TENSOR_SPLIT=1,1

# Reranker für den Chatbot (zweiter llama-server auf Port 8082), GGUF in /srv/gala/models:
# https://huggingface.co/gpustack/bge-reranker-v2-m3-GGUF (Q8_0, 0,64 GB, ~0,5 GB VRAM).
RERANK_MODEL=bge-reranker-v2-m3-Q8_0.gguf
# GPU-Index (PCI-Reihenfolge); auf der RTX 3070 (0) ~0,4 s je Suche, auf der GTX 1070 ~2,4 s.
RERANK_GPU=0

# Image-Tag von ghcr.io/ggml-org/llama.cpp, am besten auf einen Build pinnen
# (Tags: https://github.com/ggml-org/llama.cpp/pkgs/container/llama.cpp).
# "server-cuda" ist mit CUDA 12 gebaut. Nicht "server-cuda13" nehmen: CUDA 13 unterstützt die
# GTX 1070 (Pascal) nicht mehr. Geprüft am 26.11.2026: server-cuda-b12723 auf RTX 3070 + GTX 1070.
LLAMA_IMAGE_TAG=server-cuda-b12723
