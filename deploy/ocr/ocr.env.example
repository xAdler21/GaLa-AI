# gala-ocr: Konfiguration. Kopie nach /etc/gala/ocr.env (Rechte 0640 root:root).
# Format: nur KEY=VALUE, ohne Anführungszeichen und Sonderzeichen im Wert.

# Zugang zur Postgres-Datenbank auf gala-coordinator.
# Das Passwort muss mit POSTGRES_PASSWORD in /etc/gala/coordinator.env übereinstimmen.
POSTGRES_DB=gala
POSTGRES_USER=gala
POSTGRES_PASSWORD=

GALA_LLM_URL=http://gala-llm:8080
RUST_LOG=info

# Build-Features des Workers. "vision" ist für die Rolle vision Pflicht
# (ohne das Feature beendet sich der Worker sofort).
GALA_WORKER_FEATURES=vision

# OCR-Gerät: cuda oder cpu. Die vorgebaute ONNX Runtime (ort 2.0.0-rc.13) gibt es
# nur für CUDA 13, das die GTX 950 (Maxwell) nicht mehr unterstützt. Mit "cuda"
# fällt der Worker dort beim Start mit einer Fehlermeldung auf die CPU zurück;
# "cpu" macht das ausdrücklich (siehe docs/BETRIEB.md, GTX-950-Risiko).
GALA_OCR_DEVICE=cuda

# CUDA-Runtime-Image des Workers. Maxwell (sm_52) braucht CUDA 12.x (CUDA 13
# hat Maxwell entfernt). Gleiches Image wie docker/bench.Dockerfile.
GALA_CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
