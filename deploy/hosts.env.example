# GaLa-AI: Netzwerk-Eckdaten, identisch auf allen drei VMs.
#
# Installation: nach /etc/gala/hosts.env kopieren und anpassen
#   sudo install -d -m 0755 /etc/gala
#   sudo install -m 0644 /opt/gala/deploy/hosts.env.example /etc/gala/hosts.env
#
# Format: nur KEY=VALUE, ohne Leerzeichen und Anführungszeichen
# (die Datei wird von Shell-Skripten gelesen und von docker compose).
# Die Beispielwerte 192.0.2.x (Dokumentationsbereich) und NAS-IP werden von
# den install.sh-Skripten als "nicht angepasst" abgelehnt.

# Feste IP-Adressen der VMs. Die Hostnamen gala-coordinator, gala-ocr und
# gala-llm werden von install.sh in /etc/hosts eingetragen (und per
# extra_hosts in die Container gereicht), es ist also kein eigener DNS nötig.
#
# Aufbau in Etappen: Gibt es gala-ocr oder gala-llm noch nicht, dort "none"
# eintragen. Dann entfallen NFS-Export, Firewall-Freigaben und SSH-Updates für
# diese VM; Chatbot bzw. OCR melden "nicht erreichbar". Sobald die VM steht,
# IP eintragen und install.sh auf gala-coordinator erneut ausführen.
GALA_COORDINATOR_IP=192.0.2.10
GALA_OCR_IP=192.0.2.11
GALA_LLM_IP=192.0.2.12

# Netze, aus denen SSH und die Weboberfläche (Caddy, 443) erreichbar sind.
# Mehrere Netze durch Komma trennen, z. B. LAN und VPN: 10.0.0.0/8,192.168.2.0/24
GALA_LAN_CIDR=192.0.2.0/24

# Netzlaufwerk mit dem Dokumentenarchiv (SMB/CIFS), wird read-only nach
# /mnt/archiv eingebunden (gala-coordinator und gala-ocr).
# "none": noch kein NAS, /mnt/archiv bleibt leer.
GALA_NAS_SHARE=//NAS-IP/share
# SMB-Protokollversion; bei alten NAS-Geräten ggf. 2.1
GALA_NAS_SMB_VERS=3.0

# Git-Quelle für /opt/gala (wird nur zum Klonen benutzt, falls /opt/gala
# noch nicht existiert; auf den VMs ohne Internet-Zugriff nicht nötig).
GALA_REPO_URL=
