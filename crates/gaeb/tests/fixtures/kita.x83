                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt><Text><p><span>Baustelleneinrichtung vorhalten und räumen</span></p><p><span>inkl. Bauzaun.</span></p></Text></DetailTxt>
                      </CompleteText>
                    </Description>
                  </Item>
                  <MarkupItem ID="M1" RNoPart="90">
                    <Description><CompleteText><OutlineText><OutlTxt><TextOutlTxt><p>Zuschlag Winterbau</p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description>
                  </MarkupItem>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
