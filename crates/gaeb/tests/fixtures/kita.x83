  <Award>
    <DP>83</DP>
    <BoQ ID="BOQ1">
      <BoQInfo>
        <Name>LV Freianlagen</Name>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="C1" RNoPart="1">
          <LblTx><p><span>Pflasterarbeiten</span></p></LblTx>
          <BoQBody>
            <BoQCtgy ID="C11" RNoPart="01">
              <LblTx><p><span>Wege &amp; Plätze</span></p></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R1">
                    <Description>
                      <CompleteText>
                        <DetailTxt><Text><p><span>Alle Pflasterflächen mit 2,5 % Gefälle herstellen.</span></p></Text></DetailTxt>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I1" RNoPart="10">
                    <Qty>120.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Betonsteinpflaster 20x10x8 cm, grau,</span></p>
                            <p><span>im Sandbett verlegen.</span><br/><span>Fugen mit Brechsand verfüllen.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText><OutlTxt><TextOutlTxt><p><span>Betonsteinpflaster 20x10x8 liefern und verlegen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I2" RNoPart="20">
                    <Provis>WithoutTotal</Provis>
                    <Qty>15.000</Qty>
                    <QU>lfm</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><p><span>Tiefbordstein 8x25 zusätzlich setzen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I3" RNoPart="30">
                    <ALNGroupNo>1</ALNGroupNo>
                    <ALNSerNo>0</ALNSerNo>
                    <Qty>40.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><p><span>Rasenfugenpflaster liefern und verlegen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I4" RNoPart="40">
                    <ALNGroupNo>1</ALNGroupNo>
                    <ALNSerNo>1</ALNSerNo>
                    <Qty>40.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><p><span>Rasengittersteine als Alternative</span></p></TextOutlTxt></OutlTxt></OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C2" RNoPart="02">
          <LblTx><p><span>Allgemeines</span></p></LblTx>
          <BoQBody>
            <BoQCtgy ID="C21" RNoPart="1">
              <LblTx><p>Baustelle und Stundenlohn</p></LblTx>
              <BoQBody>
                <Itemlist>
                  <Item ID="I5" RNoPart="10">
                    <HourIt>Yes</HourIt>
                    <Qty>10</Qty>
                    <QU>Std</QU>
                    <Description>
                      <CompleteText>
                        <OutlineText><OutlTxt><TextOutlTxt><p><span>Facharbeiterstunde</span></p></TextOutlTxt></OutlTxt></OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I6" RNoPart="20">
                    <LumpSumItem>Yes</LumpSumItem>
